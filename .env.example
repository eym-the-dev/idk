NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx

# Dikkat: NEXT_PUBLIC_ öneki YOK — bu değer sadece sunucuda
# (app/api/generate-dynamic-prompt/route.ts) okunur, tarayıcıya asla gitmez.
GEMINI_API_KEY=xxxxx

# Dikkat: BU KEY RLS'İ BYPASS EDER. Sadece app/api/account/delete gibi
# sunucu route'larında kullanılır, NEXT_PUBLIC_ öneki ASLA eklenmemeli.
# Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=xxxxx
